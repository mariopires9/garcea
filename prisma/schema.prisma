// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // The protected owner account: the only one that can add/remove accounts
  // and change other accounts' details. Can't be removed.
  isOwner      Boolean  @default(false)
  createdAt    DateTime @default(now())

  events       Event[]
  galleryItems GalleryItem[]
}

enum EventType {
  FOLCLORE
  OUTROS
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  date        DateTime
  location    String
  posterUrl   String?
  type        EventType @default(FOLCLORE)
  createdAt   DateTime  @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  galleryItems GalleryItem[]
}

enum GalleryItemType {
  PHOTO
  VIDEO
}

model GalleryItem {
  id           String          @id @default(cuid())
  type         GalleryItemType
  url          String
  thumbnailUrl String?
  caption      String?
  createdAt    DateTime        @default(now())

  eventId   String?
  event     Event?  @relation(fields: [eventId], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  homeSectionFeatures HomeSectionFeaturedPhoto[]
}

model HomeSection {
  id          String   @id @default(cuid())
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  featuredPhotos HomeSectionFeaturedPhoto[]
}

model HomeSectionFeaturedPhoto {
  id            String      @id @default(cuid())
  homeSectionId String
  homeSection   HomeSection @relation(fields: [homeSectionId], references: [id], onDelete: Cascade)
  galleryItemId String
  galleryItem   GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([homeSectionId, galleryItemId])
}

model HistorialSection {
  id          String   @id
  description String
  updatedAt   DateTime @updatedAt
}

enum OfficialContactType {
  EMAIL
  PHONE
  FACEBOOK
}

model OfficialContact {
  id        String              @id @default(cuid())
  type      OfficialContactType
  label     String?
  value     String
  createdAt DateTime            @default(now())
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  TWITTER
  WHATSAPP
  SPOTIFY
  OTHER
}

model SocialLink {
  id        String         @id @default(cuid())
  platform  SocialPlatform
  url       String
  order     Int            @default(0)
  createdAt DateTime       @default(now())
}
