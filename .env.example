# Copy to .env.local (and set the same names in Vercel -> Settings ->
# Environment Variables). Never commit real values.

# --- Required ---------------------------------------------------------------

# Supabase Postgres connection string (Prisma). Use the pooler URL.
DATABASE_URL=
# Supabase project URL and service-role key (server-side Storage uploads/deletes).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Secret used to sign login sessions (any long random string).
NEXTAUTH_SECRET=

# --- Optional: defaults are used when a value is left empty ------------------
# Settings are read in src/lib/config.ts; out-of-range values are clamped.
# NEXT_PUBLIC_* values are built into the site: after changing one on Vercel,
# redeploy for it to take effect.

# Storage bucket for photos and posters.            Default: gallery-photos
SUPABASE_STORAGE_BUCKET=
# Public address used in link previews, canonical URLs and the sitemap.
# Default: Vercel's production domain, or http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=

# Site name in the header, footer, page titles and previews.
# Default: Associação GARCEA
NEXT_PUBLIC_SITE_NAME=
# Default description for search engines and link previews.
# Default: Site oficial da Associação GARCEA e do Rancho Folclórico das Lavradeiras de Gondar: eventos, historial e contactos.
SITE_DESCRIPTION=

# Gallery items per batch ("Ver mais" adds this many).  Default: 24  (1-200)
GALLERY_PAGE_SIZE=

# Max size of one upload request in MB. Vercel rejects requests over 4.5MB,
# so this can't go above 4.4.                          Default: 4   (0.5-4.4)
NEXT_PUBLIC_MAX_UPLOAD_MB=
# Photos per gallery upload.                           Default: 15  (1-100)
NEXT_PUBLIC_MAX_PHOTOS_PER_UPLOAD=
# Longest side (px) photos are resized to before upload. Default: 1920 (320-8000)
NEXT_PUBLIC_PHOTO_MAX_DIMENSION=
# Longest side (px) for event posters.                 Default: 2560 (320-8000)
NEXT_PUBLIC_POSTER_MAX_DIMENSION=
# Compression quality for uploaded images.            Default: 0.82 (0.1-1)
NEXT_PUBLIC_IMAGE_QUALITY=

# Minimum password length (can't go below 8).         Default: 8   (8-128)
MIN_PASSWORD_LENGTH=

# --- Seed script only (npx prisma db seed) ----------------------------------
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
